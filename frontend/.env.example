# Set these to your public backend URL. For the free laptop option, use the
# https://*.trycloudflare.com URL printed by scripts/start-public-backend.ps1.
VITE_API_BASE_URL=https://your-public-backend.example.com
VITE_PHONE_CAMERA_BASE_URL=https://your-public-backend.example.com
# Required by the Google Sign-In button on Vercel.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
