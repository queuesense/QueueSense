# Copy this file to .env. Do not commit .env.
# Generate APP_AUTH_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The first Google account owner; all other first-time sign-ins are viewers.
APP_OWNER_EMAIL=yourname@gmail.com
# Create a Google OAuth Web application Client ID and use the same value below.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APP_AUTH_SECRET=Replace-with-at-least-32-random-characters
# In production, set this to the HTTPS URL users open, e.g. https://queues.example.com
VITE_PUBLIC_BASE_URL=
QUEUE_SENSE_PORT=8080
# Required only when frontend and backend use different origins.
CORS_ORIGINS=
